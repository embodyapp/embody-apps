# Local runtime defaults (start loads .env; dev uses embody.config.ts).
NODE_ENV=development
PORT=3031
DATABASE_FILE=.embody/kanban.sqlite
# Inspector is loopback-only. Do not publish development hosts.
# Production PostgreSQL isolation and deployment are NOT verified/supported yet.
# Future gateway configuration names (no real credentials here):
# GATEWAY_URL=https://gateway.example.com
# PUBLIC_URL=https://kanban.example.com
# GATEWAY_REGISTRATION_SECRET=
# GATEWAY_JWT_ISSUER=
# GATEWAY_JWT_SECRET=
# Client-side environment, separate from host secrets:
# EMBODY_GATEWAY_URL=https://gateway.example.com
# EMBODY_TOKEN=
